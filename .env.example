# CommonGround environment example. Keep real values out of source control.
# The Python service reads process environment, not .env files automatically.

# Local SQLite/Docker only. Do not use SQLite for Vercel serverless persistence.
CG_DB=./data/commonground.sqlite3
CG_HOST=127.0.0.1
PORT=8000

# Vercel requires a managed PostgreSQL URL. Set ONE in the hosting secret store.
# DATABASE_URL=
# POSTGRES_URL=

# For HTTPS deployment, set the exact public origin and secure cookies.
CG_ORIGIN=
CG_SECURE_COOKIE=0

# Optional only for automated creation of fictional local accounts.
# Set through a secret manager or interactive shell; never commit a password.
CG_SEED_PASSWORD=
